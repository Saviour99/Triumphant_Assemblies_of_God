# Copy this file to .env and fill in real values.
# .env itself is git-ignored — never commit real secrets.

FLASK_ENV=development
FLASK_APP=run.py
# REQUIRED in production (>= 32 chars; the app refuses to start otherwise):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Dev server (python run.py) binds to 127.0.0.1 by default; debug follows
# FLASK_ENV unless FLASK_DEBUG is set. Never expose the debugger publicly.
# RUN_HOST=127.0.0.1
# PORT=5001
# FLASK_DEBUG=1

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=Triumphant

# Optional: for production (ProductionConfig reads these too)
# MYSQL_HOST=your-production-host
# MYSQL_USER=your-db-user
# MYSQL_PASSWORD=your-db-password
# MYSQL_DB=tag_church_prod
# REDIS_URL=redis://localhost:6379/0

# Paystack (leave blank in dev; giving/init will 503 without a secret key)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Mailchimp newsletter (admin > Newsletter > Compose). Until the API key,
# audience id and SITE_URL are set, newsletters can be drafted/previewed
# but the send buttons stay disabled.
# API key: Mailchimp > Profile > Extras > API keys > Create A Key.
MAILCHIMP_API_KEY=
# Optional: the "us21"-style part after the dash in the API key; derived
# from the key automatically when left blank.
MAILCHIMP_SERVER_PREFIX=
# Audience > All contacts > Settings > Audience name and defaults > Audience ID.
MAILCHIMP_AUDIENCE_ID=
# Sender display name (defaults to "Triumphant Assemblies of God").
MAILCHIMP_FROM_NAME=
# Fallback reply-to used when the sending admin's own email is a free-mail
# address (gmail, yahoo...). Should be on a domain authenticated in Mailchimp.
MAILCHIMP_REPLY_TO=
# Absolute public URL of this site, e.g. https://www.example.org — used for
# the logo and links inside emails, password-reset links, sitemap.xml and
# robots.txt. REQUIRED in production: the app refuses to start without it
# and only accepts requests whose Host header is this host (or its www/bare
# twin) — Host-header poisoning protection.
SITE_URL=
# Optional extra hostnames to accept in production, comma-separated.
# ALLOWED_HOSTS=church-app.onrender.com

# Reverse proxy settings (production):
# TRUST_PROXY=1  -> the app sits behind exactly ONE proxy that sets
#   X-Forwarded-For / X-Forwarded-Proto (nginx, a PaaS router, Cloudflare).
#   Enables werkzeug ProxyFix(x_for=1, x_proto=1). Leave unset if gunicorn
#   is exposed directly, or visitors could spoof their IP.
TRUST_PROXY=
# CLOUDFLARE_PROXY=1 -> traffic comes through Cloudflare; rate limits and
#   the admin login log use the CF-Connecting-IP header (otherwise every
#   visitor shares Cloudflare's IP and hits the same rate limit). Only safe
#   if the origin server accepts connections from Cloudflare IPs alone.
CLOUDFLARE_PROXY=

# Transactional email (password resets, contact/prayer alerts).
# Provider order: RESEND_API_KEY set -> Resend; else SMTP_HOST set -> SMTP;
# else emails are NOT sent: only recipient/subject are logged (in
# development the plain-text body is also printed to the server console).
# These can also be set by an admin in the dashboard (saved values win).
#
# Resend (recommended): https://resend.com
#   1. Domains -> Add Domain (e.g. mail.yourchurch.org), add the DNS records
#      it shows (SPF/DKIM TXT + MX on the send subdomain; DMARC optional
#      but recommended) at your DNS host, then click Verify.
#   2. API Keys -> Create API Key, permission "Sending access" (restrict it
#      to that domain). Paste it below; it's shown only once.
#   3. MAIL_FROM must use an address on that verified domain, or Resend
#      rejects the send (403 validation_error).
RESEND_API_KEY=
# MAIL_FROM="Triumphant Assemblies of God <no-reply@mail.yourchurch.org>"
MAIL_FROM=
# Optional: where replies go (e.g. the church office inbox).
MAIL_REPLY_TO=
# Optional: church inbox that gets an email for each new contact-form
# message and prayer request. Leave blank to disable.
MAIL_NOTIFY_TO=
#
# Legacy fallback, used only when RESEND_API_KEY is blank. MAIL_FROM (or
# SMTP_FROM) is the sender.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Seeded accounts: init_db.py creates each one ONCE, only if its
# *_DEFAULT_PASSWORD is set (>= 12 chars). There are no built-in fallback
# passwords. Use unique strong passwords and change them after first login.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@triumphantag.com
ADMIN_DEFAULT_PASSWORD=

# Developer account (same dashboard access as admin, plus exclusive pages —
# My Profile, Manage Admins, Login History)
DEVELOPER_DEFAULT_USERNAME=developer
DEVELOPER_DEFAULT_EMAIL=developer@triumphantag.com
DEVELOPER_DEFAULT_PASSWORD=

# Pastor account (same dashboard access as admin)
PASTOR_DEFAULT_USERNAME=pastor
PASTOR_DEFAULT_EMAIL=pastor@triumphantag.com
PASTOR_DEFAULT_PASSWORD=
