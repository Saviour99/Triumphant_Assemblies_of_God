# Copy this file to .env and fill in real values.
# .env itself is git-ignored — never commit real secrets.

FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-to-a-long-random-string

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=Triumphant

# Optional: for production (ProductionConfig reads these too)
# MYSQL_HOST=your-production-host
# MYSQL_USER=your-db-user
# MYSQL_PASSWORD=your-db-password
# MYSQL_DB=tag_church_prod
# REDIS_URL=redis://localhost:6379/0

# Paystack (leave blank in dev; giving/init will 503 without a secret key)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Optional: real email delivery for password resets. If SMTP_HOST is unset,
# reset links are logged (and flashed in debug mode) instead of emailed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Admin account (seeded once by init_db.py if no matching username/email exists)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@triumphantag.com
ADMIN_DEFAULT_PASSWORD=ChangeMe123!

# Developer account (same dashboard access as admin, plus exclusive pages —
# My Profile, Manage Admins, Login History)
DEVELOPER_DEFAULT_USERNAME=developer
DEVELOPER_DEFAULT_EMAIL=developer@triumphantag.com
DEVELOPER_DEFAULT_PASSWORD=ChangeDev123!

# Pastor account (same dashboard access as admin)
PASTOR_DEFAULT_USERNAME=pastor
PASTOR_DEFAULT_EMAIL=pastor@triumphantag.com
PASTOR_DEFAULT_PASSWORD=ChangePastor123!
